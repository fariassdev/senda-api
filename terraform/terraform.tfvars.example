# ==============================================================================
# Senda - Terraform Variables Example
# ==============================================================================
# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to version control (it's in .gitignore)
# ==============================================================================

# Required: Your Google Cloud Project ID
project_id = "your-gcp-project-id"

# Optional: GCP region (default: us-central1 for free tier eligibility)
# Valid free tier regions: us-central1, us-east1, us-west1
region = "us-central1"

# Optional: Application name (default: senda)
app_name = "senda"

# ==============================================================================
# Environment Variables
# ==============================================================================
# These are passed to Cloud Run services. For sensitive values, consider using
# GCP Secret Manager instead of storing them here.
#
# Example configuration:
#
# staging_env_vars = {
#   "POSTGRES_HOST"         = "your-staging-db-host"
#   "POSTGRES_PORT"         = "5432"
#   "POSTGRES_USER"         = "postgres"
#   "POSTGRES_PASSWORD"     = "your-staging-password"
#   "POSTGRES_DB"           = "senda_staging"
#   "JWT_SECRET_KEY"        = "your-staging-jwt-secret"
#   "SECRET_KEY"            = "your-staging-secret"
#   "AWS_ACCESS_KEY_ID"     = "your-access-key-id"
#   "AWS_SECRET_ACCESS_KEY" = "your-secret-access-key"
#   "AWS_S3_BUCKET"         = "your-s3-bucket"
#   "AWS_DEFAULT_REGION"    = "your-default-region"
#   "GEMINI_API_KEY"        = "your-gemini-api-key"
#   "MODAL_TTS_ENDPOINT"    = "https://username--senda-tts-chatterbox-synthesize.modal.run"
#   "MODAL_SYNC_VOICE_ENDPOINT"   = "https://username--senda-tts-chatterbox-sync-voice.modal.run"
#   "MODAL_DELETE_VOICE_ENDPOINT" = "https://username--senda-tts-chatterbox-delete-voice.modal.run"
#   "MODAL_TOKEN_ID"        = "ak-xxxxxxxxxxxx"
#   "MODAL_TOKEN_SECRET"    = "as-xxxxxxxxxxxx"
#   "MODAL_PROXY_AUTH_TOKEN_ID"     = "wk-xxxxxxxxxxxx"
#   "MODAL_PROXY_AUTH_TOKEN_SECRET" = "ws-xxxxxxxxxxxx"
#   "KOKORO_API_URL"        = "http://my-kokoro-api.app/v1/audio/speech"
#   "KOKORO_API_TIMEOUT"    = "60"
#   "CORS_ALLOWED_ORIGINS"  = "https://my-frontend.app"
# }
#
