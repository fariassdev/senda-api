# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=senda
POSTGRES_PASSWORD=senda_password
POSTGRES_DB=senda

# Application
APP_ENV=dev
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_TOKEN_EXPIRATION_MINUTES=10080
JWT_ALGORITHM=HS256

# CORS Configuration (comma-separated list of allowed origins)
# For production, set specific origins. Use something more flexible value for development.
# Example: http://localhost:3000,https://senda-cms-tfg.vercel.app,https://*.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI Generation
GEMINI_API_KEY=your-gemini-api-key

# Audio Generation
KOKORO_API_URL=http://localhost:8880/v1/audio/speech
# Timeout in seconds for TTS requests (increase for remote servers or cold starts).
# Notice that if you are using KokoroTTS with CPU the generation time will be considerably longer.
KOKORO_API_TIMEOUT=60
AWS_S3_BUCKET=senda-ai
AWS_DEFAULT_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret

# Audio Generation Concurrency
MAX_CONCURRENT_LESSONS=5
MAX_CONCURRENT_TTS=3
